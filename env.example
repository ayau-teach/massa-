# ─────────────────────────────────────────────────────────────
#  PHYSICS LAB — серверлік баптау
#  Бұл файлды «.env» деп көшіріп, өз кілттеріңді жаз:
#     cp backend/.env.example backend/.env
#  .env файлын ешқашан GitHub-қа немесе басқа адамдарға жіберме!
# ─────────────────────────────────────────────────────────────

PORT=3000

# ── AI физика көмекшісі ──
# anthropic немесе openai (бос қалса — бар кілтке қарай автоматты таңдалады)
AI_PROVIDER=anthropic

# Anthropic (Claude): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Модель (әдепкі: claude-opus-5-5). Арзанырақ нұсқа: claude-sonnet-5-5 немесе claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Сұраныс қауіпсіздік сүзгісінен өтпесе, сервер жағында басқа модельмен қайталау (on/off)
ANTHROPIC_FALLBACKS=on

# OpenAI: https://platform.openai.com → API keys
OPENAI_API_KEY=
# OpenAI моделін өз аккаунтыңда қолжетімді нұсқаға ауыстыр
OPENAI_MODEL=gpt-4o-mini

# ── Қолжазбаны мәтінге айналдыру ──
# mathpix | anthropic | openai  (бос қалса — Mathpix, болмаса AI кілті қолданылады)
OCR_PROVIDER=
# Mathpix математикалық OCR: https://mathpix.com/ocr → API
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Сайт басқа доменде, ал backend бөлек серверде болса — сайттың мекенжайы:
# ALLOWED_ORIGIN=https://example.kz
